# Semua opsional. Salin ke .env bila memakai docker compose, atau ekspor sebagai variabel lingkungan.
SKAKMAT_HOST=127.0.0.1          # 0.0.0.0 agar bisa dibuka dari perangkat lain
SKAKMAT_PORT=8000
SKAKMAT_DB=skakmat.db           # lokasi file SQLite
SKAKMAT_STOCKFISH=              # path program Stockfish; kosong = cari di PATH; "mati" = tanpa engine
SKAKMAT_COOKIE_SECURE=0         # 1 bila dilayani lewat HTTPS
SKAKMAT_PROXY_IPS=127.0.0.1     # alamat reverse proxy yang dipercaya untuk X-Forwarded-For
SKAKMAT_DOCS=0                  # 1 = buka dokumentasi API otomatis di /api/docs
